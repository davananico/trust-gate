# Salin file ini menjadi .env. File .env TIDAK ikut ke Git.
# Format: provider:nama-model. Isi "fake" untuk menjalankan tanpa LLM (hanya menguji alur).
# Model eksperimen (Ollama di server lab): ollama:qwen3:8b, ollama:llama3.1:8b, ollama:gemma4:12b, ollama:olmo-3:7b-instruct
LLM_MODEL=ollama:qwen3:8b
# Alamat Ollama. Default = terowongan SSH dari laptop: ssh -N -L 11434:127.0.0.1:11434 USERNAME@ALAMAT-SERVER
OLLAMA_HOST=http://127.0.0.1:11434
# Mematikan telemetri anonim ChromaDB
ANONYMIZED_TELEMETRY=False
