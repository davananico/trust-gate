# Salin file ini menjadi .env lalu isi kuncinya. File .env TIDAK ikut ke Git.
OPENAI_API_KEY=isi-kunci-api-di-sini
# Format: provider:nama-model. Isi "fake" untuk menjalankan tanpa API.
LLM_MODEL=openai:gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
# Mematikan telemetri anonim ChromaDB
ANONYMIZED_TELEMETRY=False
