# Copy this file to .env. The .env file is NOT committed to Git.
# Format: provider:model-name. Use "fake" to run without an LLM (pipeline test only).
# Experiment models (Ollama on the lab server): ollama:qwen3:8b, ollama:llama3.1:8b, ollama:gemma4:12b, ollama:olmo-3:7b-instruct
LLM_MODEL=ollama:qwen3:8b
# Ollama address. Default = an SSH tunnel from a laptop: ssh -N -L 11434:127.0.0.1:11434 USERNAME@SERVER-ADDRESS
OLLAMA_HOST=http://127.0.0.1:11434
# Disable ChromaDB anonymous telemetry
ANONYMIZED_TELEMETRY=False
